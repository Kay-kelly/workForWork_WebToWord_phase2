{
  "title": "Cycle Diagram Report",
  "template_path": "templates/word/mvp_report_template.docx",
  "output_dir": "output/pipeline_mvp/word",
  "filename_pattern": "{output_name}.docx",
  "placeholders": {
    "{{report_title}}": {
      "value": "Cycle Diagram Report"
    },
    "{{record_id}}": {
      "source": "record_id"
    },
    "{{project_id}}": {
      "source": "project_id"
    },
    "{{test_id}}": {
      "source": "test_id"
    },
    "{{batch_sequence_id}}": {
      "source": "batch_sequence_id"
    },
    "{{cycle_count}}": {
      "source": "cycle_count"
    }
  },
  "image_placeholders": {
    "{{cycle_image}}": {
      "width_inches": 6.5
    }
  },
  "image": {
    "caption": "Generated Cycle Diagram",
    "width_inches": 6.5
  },
  "fields": [
    {
      "source": "report_date",
      "label": "Report Date"
    },
    {
      "source": "cycle_count",
      "label": "Cycle Count"
    },
    {
      "source": "duration_min",
      "label": "Duration (min)"
    },
    {
      "source": "outer_high_temp",
      "label": "Outer High Temp"
    },
    {
      "source": "inner_high_temp",
      "label": "Inner High Temp"
    },
    {
      "source": "inner_low_temp",
      "label": "Inner Low Temp"
    },
    {
      "source": "outer_low_temp",
      "label": "Outer Low Temp"
    },
    {
      "source": "baseline_temp",
      "label": "Baseline Temp"
    },
    {
      "source": "start_label",
      "label": "Start Label"
    }
  ]
}
